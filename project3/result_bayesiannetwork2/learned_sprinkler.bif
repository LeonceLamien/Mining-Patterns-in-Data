variable Cloudy {
  type discrete [ 2 ] { 0, 1 };
}
variable Rain {
  type discrete [ 2 ] { 0, 1 };
}
variable Sprinkler {
  type discrete [ 2 ] { 0, 1 };
}
variable Wet_Grass {
  type discrete [ 2 ] { 0, 1 };
}
probability ( Cloudy ) {
  table 0.5, 0.5;
}
probability ( Rain ) {
  table 0.5, 0.5;
}
probability ( Sprinkler ) {
  table 0.5, 0.5;
}
probability ( Wet_Grass ) {
  table 0.5, 0.5;
}
